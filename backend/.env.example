# === Core ===
MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dentistai
JWT_SECRET=CHANGE-ME-TO-A-LONG-RANDOM-STRING
COOKIE_SECURE=true
# Comma-separated list of allowed frontend origins.
# Both FRONTEND_URL and CORS_ORIGINS are merged — set either or both.
FRONTEND_URL=https://dentistai.com,https://www.dentistai.com,https://0-ai00.vercel.app
CORS_ORIGINS=

# === Admin seed (set once, rotate ADMIN_PASSWORD in prod) ===
ADMIN_EMAIL=admin@dentistai.com
ADMIN_PASSWORD=change-me

# === Anthropic (for ARIA chat) ===
ANTHROPIC_API_KEY=

# === Twilio ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=

# === Retell AI ===
RETELL_API_KEY=
RETELL_AGENT_ID=
# Optional: verify Retell webhook HMAC signatures
RETELL_WEBHOOK_SECRET=

# === SendGrid ===
SENDGRID_API_KEY=
FROM_EMAIL=noreply@dentistai.com

# === Paddle Billing ===
# sandbox or live
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
# Client-side token from Paddle dashboard > Developer tools > Authentication
# Safe to expose — the frontend needs this to open the checkout overlay
PADDLE_CLIENT_TOKEN=
# Webhook signing secret from Paddle dashboard > Developer tools > Notifications
PADDLE_WEBHOOK_SECRET=
# Price IDs (pri_xxx) from Paddle dashboard > Catalog > Products
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_PRO=

# === Feature flags ===
# Set DEMO_MODE=true to bypass subscription gates (for the demo account)
DEMO_MODE=false

# === Google OAuth (for Google Calendar integration) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.dentistai.com/api/google/callback

# === Observability (optional) ===
SENTRY_DSN=
